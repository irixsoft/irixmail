[Unit]
Description=IRIXMAIL mail server
Documentation=https://irixsoft.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=irixmail
Group=irixmail
ExecStart=/usr/local/bin/irixmail run
Restart=on-failure
RestartSec=5

# Bind the privileged mail and HTTP ports without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Filesystem hardening: only the data, log, and config paths are writable.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/irixmail /var/log/irixmail /etc/irixmail

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
